# No database is created by default. Keep actual credentials out of source control.
# Docker Compose reads a local .env; direct Python launches need exported variables.
RECOVERAI_PROFILE=development

# Existing PostgreSQL failed-payment database, using a SELECT-only database role.
RECOVERAI_SOURCE_URL=
# Example only: set this to a SELECT over YOUR existing table or view.
RECOVERAI_SOURCE_QUERY=
RECOVERAI_SOURCE_PROVIDER=razorpay
RECOVERAI_SOURCE_TENANT=default
RECOVERAI_SOURCE_LIMIT=5000
# JSON mapping of source column names to Transaction fields; {} means matching names.
RECOVERAI_SOURCE_COLUMNS={}

# Optional separate recovery-state database. Not needed to browse source payments.
# Provision the recovery schema explicitly before enabling jobs/reviews/audits.
RECOVERAI_DB_URL=
RECOVERAI_JWT_SECRET=
RECOVERAI_WEBHOOK_SECRET=
RECOVERAI_API_KEYS=

# Optional JSON training baseline for drift monitoring, mounted on the server.
RECOVERAI_DRIFT_BASELINE_FILE=

# Historical UCI browsing without a database (fetch with python -m scripts.fetch_uci).
# RECOVERAI_SOURCE=uci
# RECOVERAI_UCI_PATH=data/external/uci_credit.xls
